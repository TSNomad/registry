{
  "name": "@tsnomad/registry",
  "version": "0.1.0",
  "description": "Registry for lazy loaded named collections, the TypeScript counterpart to PHPNomad's registry package",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsnomad/registry.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./registry": {
      "types": "./dist/Registry.d.ts",
      "default": "./dist/Registry.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./can-get": {
      "types": "./dist/CanGet.d.ts",
      "default": "./dist/CanGet.js"
    },
    "./can-set": {
      "types": "./dist/CanSet.d.ts",
      "default": "./dist/CanSet.js"
    },
    "./can-delete": {
      "types": "./dist/CanDelete.d.ts",
      "default": "./dist/CanDelete.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "pretypecheck": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "pretest": "npm run build",
    "test": "node --test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
